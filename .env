# OrynTap door-counter simulator settings.
# Copy this file to iot/.env and fill it in.  iot/.env is in .gitignore: NEVER commit it.

# Supabase -> Project Settings -> API (or Data API): the Project URL.
# "https://xyz.supabase.co" and "https://xyz.supabase.co/rest/v1/" both work.
SUPABASE_URL=https://ausnycqeqjydsesppdud.supabase.co

# The PUBLIC key: the same publishable (sb_publishable_...) or legacy "anon" key as in js/config.js.
# NEVER the secret key (sb_secret_...) or the service_role key.
SUPABASE_KEY=sb_publishable_qrXjBqJlhlxtUoNoUZNcEQ_vdWU2fC2

# The sensor secret shown ONCE by register_sensor(...) in database/08_iot_occupancy.sql
SENSOR_TOKEN=23e391caca57990d9ffaeb8560d0c42b935cc21eb8da1a5c

# id of the AITU Library in study_spaces (the same SELECT in 08 shows it)
SPACE_ID=1

# Optional
SEND_INTERVAL=10      # seconds between readings (6 or more; the database accepts 1 per 5 s)
START_PEOPLE=40       # people inside when the simulator starts
